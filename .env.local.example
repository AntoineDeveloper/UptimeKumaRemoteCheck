# =============================================================================
# Uptime Kuma Remote Check — configuration
# Copy this file to ".env.local" and fill in the values, OR just run:
#     npm run setup
# which generates strong secrets for you.
# =============================================================================

# ---- Required ---------------------------------------------------------------
# The shared secret Uptime Kuma must send on every /check request.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 24 characters. THIS PROTECTS A PUBLICLY EXPOSED SERVICE — keep it secret.
AUTH_SECRET=

# ---- Admin GUI --------------------------------------------------------------
# Password for the web GUI that manages the allowlist.
# If left blank, it falls back to AUTH_SECRET (a separate value is recommended).
ADMIN_PASSWORD=

# Set to false to completely disable the web GUI (check endpoint still works).
ADMIN_ENABLED=true

# Secret used to sign session cookies. If blank, a random one is generated at
# each boot (existing GUI sessions reset on restart — that's fine).
SESSION_SECRET=

# Set to true ONLY when the GUI is served over HTTPS (adds the Secure cookie flag).
COOKIE_SECURE=false

# ---- Networking -------------------------------------------------------------
PORT=3010
HOST=0.0.0.0

# Header carrying the secret. Default works with Uptime Kuma custom headers.
AUTH_HEADER=x-auth-token

# Trust X-Forwarded-For (true when behind nginx/Caddy/Cloudflare; false if direct).
TRUST_PROXY=true

# ---- Allowlist --------------------------------------------------------------
# Path to the allowlist file (hot-reloaded on change).
ALLOWLIST_FILE=config/allowlist.json

# ---- Check behaviour --------------------------------------------------------
DEFAULT_TIMEOUT_MS=10000
MAX_TIMEOUT_MS=60000
MAX_BODY_BYTES=65536
PING_COUNT=1

# ---- Rate limiting (defense in depth) --------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10

# ---- Logging ----------------------------------------------------------------
# error | warn | info | debug | trace   (debug is nice and verbose)
LOG_LEVEL=debug
